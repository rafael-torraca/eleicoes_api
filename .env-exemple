Android
.venv/bin/python -m uvicorn eleicoes_api.main:app --app-dir src --host 127.0.0.1 --port 8000 --reload
.venv/bin/python -m clients.telegram.main


uv run uvicorn eleicoes_api.main:app --app-dir src --reload
uv run uvicorn eleicoes_api.main:app --app-dir src --host 0.0.0.0 --port 8000
uv run python -m clients.telegram.main
